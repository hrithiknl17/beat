# Postgres connection string (Neon / Supabase / Vercel Postgres all work)
DATABASE_URL=postgres://user:password@host:5432/beat

# Shared secret Bolna sends as "Authorization: Bearer <token>" on every tool call.
# Put the same value in each custom function's "api_token" field as "Bearer <token>". Required in production.
AGENT_TOKEN=change-me

# Outbound calling ("Start beat", "Call now", callbacks). Inbound calls work without these.
BOLNA_API_KEY=bn-xxxxxxxxxxxxxxxx
# One agent per language. A shop is called by the agent for its language; BOLNA_AGENT_ID is the fallback.
BOLNA_AGENT_ID_KN=
BOLNA_AGENT_ID_HI=
BOLNA_AGENT_ID_TE=
BOLNA_AGENT_ID_TA=
BOLNA_AGENT_ID_ML=
BOLNA_AGENT_ID=
# Optional: a number you bought in Bolna to call from. Leave empty to use Bolna's default.
BOLNA_FROM_NUMBER=

# Protects /api/cron/dispatch, which dials callbacks that are due. Vercel Cron sends it automatically.
CRON_SECRET=change-me-too

# Optional: shown on the landing page as "Call Beat" so anyone can try it (10 digits).
PUBLIC_BEAT_NUMBER=
# Optional: which account gets calls to a number no account has claimed in Settings (default: the first account).
INBOUND_DISTRIBUTOR_ID=
