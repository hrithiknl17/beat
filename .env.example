# Postgres connection string (Neon / Supabase / Vercel Postgres all work)
DATABASE_URL=postgres://user:password@host:5432/beat

# Shared secret Bolna sends as "Authorization: Bearer <token>" on every tool call.
# Put the same value in each custom function's "api_token" field as "Bearer <token>".
AGENT_TOKEN=change-me

# Needed only for the "Start beat" / "Call now" buttons (outbound calls)
BOLNA_API_KEY=bn-xxxxxxxxxxxxxxxx
# One agent per language. Shops are called by the agent matching their language.
BOLNA_AGENT_ID_KN=00000000-0000-0000-0000-000000000000
BOLNA_AGENT_ID_HI=00000000-0000-0000-0000-000000000000

# PIN for dashboard buttons that place calls or change data. Viewing stays public.
DASHBOARD_PIN=1234
# Optional: a number you bought in Bolna. Leave empty to use Bolna's default.
BOLNA_FROM_NUMBER=

# Distributor name shown on the dashboard and spoken by the agent
DISTRIBUTOR_NAME=Sri Ganesh Distributors
